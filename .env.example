# 在 Vercel Production 配置。候选构建与正式站点共用这些变量。
# Django 必填项。密钥至少 50 个字符。主机名用逗号分隔，不含协议。
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=classlib-theta.vercel.app

# PostgreSQL 和私有文件存储的服务端凭据（必填）。
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 可选项。仅在使用额外受信任来源时填写完整 HTTPS 来源，多个用逗号分隔。
SUPABASE_BUCKET=classlib-private
DJANGO_CSRF_TRUSTED_ORIGINS=
